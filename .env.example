# ============================================================================
# DeskSync environment template. Copy to `.env` and fill in real values.
# NEVER commit a populated .env file.
# ============================================================================

# ---- General ----
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=debug                    # debug | info | warn | error
LOG_FORMAT=json                    # json | console

# ---- API Gateway ----
GATEWAY_HTTP_ADDR=:8080
GATEWAY_PUBLIC_URL=http://localhost:8080

# ---- Service ports (internal) ----
AUTH_HTTP_ADDR=:8081
DEVICE_HTTP_ADDR=:8082
SESSION_HTTP_ADDR=:8083
PAIRING_HTTP_ADDR=:8084
SIGNALING_HTTP_ADDR=:8085
RELAY_HTTP_ADDR=:8086
NOTIFICATION_HTTP_ADDR=:8087
MONITORING_HTTP_ADDR=:8088

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=desksync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=desksync
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://desksync:change-me@localhost:5432/desksync?sslmode=disable

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT / Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-bytes
# Access tokens are short-lived and rotated automatically; JWT_REFRESH_TTL is
# how long a client stays signed in without re-authenticating.
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h
# Window in which a just-rotated refresh token may be presented again, so a
# client that never received the rotation response can retry safely.
JWT_REFRESH_REUSE_GRACE=1m
JWT_ISSUER=desksync

# ---- OAuth ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

# ---- Signaling (session issues tickets, signaling verifies them) ----
# Shared HMAC secret for signaling tickets; MUST match between the session and
# signaling services. Use a long random value in production.
SIGNALING_TICKET_SECRET=change-me-signaling-secret-min-32-bytes
SIGNALING_TICKET_TTL=2m
# Externally reachable WebSocket URL of the signaling service, returned to
# clients when a session is created.
SIGNALING_PUBLIC_URL=ws://localhost:8085/api/v1/signaling/ws

# ---- WebRTC / ICE (STUN + Coturn TURN) ----
TURN_HOST=localhost
TURN_PORT=3478
TURN_REALM=desksync
# Shared secret for TURN REST time-limited credentials; MUST match coturn's
# static-auth-secret.
TURN_STATIC_AUTH_SECRET=change-me-turn-secret
TURN_CREDENTIAL_TTL=1h
# Comma-separated ICE server URLs returned to clients.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:localhost:3478

# ---- Firebase Cloud Messaging (mobile push) ----
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=./secrets/fcm-service-account.json

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAMESPACE=desksync

# ---- Rate limiting ----
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=15m


